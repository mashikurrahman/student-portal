# ---- Database ----
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_portal?schema=public"

# ---- Auth (NextAuth / Auth.js) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ---- Object storage (S3-compatible: AWS S3 / Cloudflare R2) ----
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="student-portal-documents"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Seconds a pre-signed URL stays valid.
STORAGE_PRESIGN_TTL_SECONDS="300"

# ---- Email (transactional) ----
EMAIL_FROM="no-reply@studentportal.local"
RESEND_API_KEY=""

# ---- App ----
NODE_ENV="development"
